# terraform.tfvars.example — concrete sample values for an APAC-resident marketing-compliance-gate deploy.
#
# Copy to terraform.tfvars and fill in your own ids. Do NOT commit terraform.tfvars.
# Region defaults to Singapore (asia-southeast1); set asia-northeast1 (JP) or
# australia-southeast1 (AU) only if that is the deploy market.

project_id = "acme-mkt-governance-sg-prod"

# Residency — already the secure default; shown for clarity. SG/JP/AU only.
region        = "asia-southeast1"
deploy_market = "SG"

# ~7-year WORM retention for the audit log. The lock has NO default: every deployment names it.
# true is IRREVERSIBLE for the retention window; false keeps the bucket destroyable.
retention_days = 2557
worm_locked    = true

# Shared-project declines. A deployment sharing its project with a stack that already owns the
# Org Policies, the data-access audit config and the perimeter declines all three, and a region
# that serves neither the malicious-URI filter nor multi-language detection narrows the guardrail:
# manage_org_policies           = false
# manage_audit_config           = false
# enable_vpc_sc                 = false
# model_armor_full_capabilities = false
#
# Embedding host: the portal's API runtime identity, filled after the portal apply mints it.
# additional_serving_service_accounts = ["journey-a-000000@acme-mkt-governance-sg-prod.iam.gserviceaccount.com"]

# The standalone consent service next-best-action calls. OFF by default: it carries an instance
# floor and bills by the hour. This example IS the next-best-action topology, so it opts in, and
# everything below through the perimeter is required only because it does.
standalone_service_enabled = true

# Org / Access Context Manager. access_policy_id is the numeric policy id.
org_id           = "123456789012"
access_policy_id = "987654321098"

# Cloud Run image: a digest in the registry artifact_registry.tf creates, in the residency region.
container_image = "asia-southeast1-docker.pkg.dev/acme-mkt-governance-sg-prod/marketing-compliance-gate/api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Managed next-best-action -> marketing-compliance-gate consent hop. The same audience is passed to next-best-action as its
# consent_store_audience; only this exact next-best-action Workload Identity may invoke the service.
s2s_audience               = "https://mkt6-consent.internal.example"
mkt5_caller_service_account = "mkt-nba-run@acme-nba-sg-prod.iam.gserviceaccount.com"

# Existing Shared VPC owned by the network platform. Both service projects must already be
# associated with this host. The subnet must be /26 or larger and enable Private Google Access.
shared_vpc_network    = "projects/acme-network-sg-prod/global/networks/mkt-prod"
shared_vpc_subnetwork = "projects/acme-network-sg-prod/regions/asia-southeast1/subnetworks/cloud-run-mkt"

# One regular sovereignty perimeter contains the Shared VPC host and BOTH service projects.
# marketing-compliance-gate is the sole owner in the reference topology; next-best-action sets manage... = false. Project
# NUMBERS are not project ids. Start in DRY-RUN and promote only after reviewing denials.
enable_vpc_sc                   = true
manage_shared_vpc_sc_perimeter = true
shared_vpc_sc_perimeter_name   = "mkt_marketing_sg"
shared_vpc_host_project_number = "333333333333"
mkt5_project_number            = "111111111111"
mkt6_project_number            = "222222222222"
vpc_sc_enforce                 = false

# Wire a real Monitoring notification channel before relying on the posture alerts.
alert_notification_channels = []
