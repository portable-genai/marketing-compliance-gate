{"id": "au-bank-clean", "asset_type": "offer", "title": "AU home loan (clean)", "body": "Variable home loan at 6.05% with a comparison rate of 6.20%. Talk to a lender today.", "market": "AU", "vertical": "banking", "fields": {}, "audience_subject_id": "subj-eval-001", "expected_failing_rule_ids": [], "expected_outcome": "compliant"}
