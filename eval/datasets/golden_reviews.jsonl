# Golden compliance-review dataset (D6). Obviously-fictional synthetic marketing assets.
# Each line: an asset + the rule ids the deterministic engine is expected to FAIL on, and
# the expected outcome. Spans BOTH verticals (banking + online retail) and ALL THREE
# markets (JP / AU / SG). expected_failing_rule_ids drives finding_accuracy.
#
# `audience_subject_id` names WHOSE consent the review reads, never what that consent is. No
# row states a consent: the subject ids are described in golden_consent.jsonl, which is the one
# place the stored state is written down, and the review resolves them through the real consent
# store at that file's `as_of`. The consent expectations below therefore follow from a stored
# record rather than from anything this file asserts: subj-eval-001 and -002 hold grants,
# subj-eval-003 has NO record (silence, which denies), -004 withdrew, and -005 has expired.
{"id": "sg-bank-clean", "asset_type": "creative", "title": "SG savings promo (clean)", "body": "Earn 4.10% per annum on your savings account. Returns are not guaranteed and your capital is at risk. Contact our team to learn more.", "market": "SG", "vertical": "banking", "fields": {"risk_warning": "Returns are subject to market conditions."}, "audience_subject_id": "subj-eval-001", "expected_failing_rule_ids": [], "expected_outcome": "compliant"}
{"id": "sg-bank-bad", "asset_type": "creative", "title": "SG savings promo (bad)", "body": "Get guaranteed returns of 4.10% with zero risk-free worry!", "market": "SG", "vertical": "banking", "fields": {}, "audience_subject_id": "subj-eval-003", "expected_failing_rule_ids": ["SG-BANK-CLAIM-GUARANTEED", "SG-BANK-APR-DISCLOSURE", "SG-BANK-RISK-WARNING", "SG-BANK-CONSENT-PDPA"], "expected_outcome": "non_compliant"}
