# marketing-compliance-gate: example environment.
#
# Export these in your shell or your runtime's environment; nothing in this repository loads a
# `.env` file for you, and a real one must never be committed (it is gitignored).
# config/settings.yaml reads the project through ${VAR:-default} interpolation, and the identity
# adapter reads the IAP settings directly. The local profile needs none of the GCP values.
#
# The hosted gate reads the MKT_GOV_PROFILE= line below to learn this repository's environment
# prefix, which is how it names MKT_GOV_REQUIRE_IAP_MATRIX for the IAP verifier matrix. Keep it.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem. There is NO default: an unset MKT_GOV_PROFILE is no choice,
# never a silent `local`, because `local` serves seeded personas with no authentication.
# `local` is the offline run: SQLite FTS5 over the bundled rule packs and a deterministic LLM.
MKT_GOV_PROFILE=local

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Identity behind IAP (gcp/platform). An embedded deployment's stack injects the audience.
# ---------------------------------------------------------------------------
# The IAP-protected resource an assertion must be addressed to. Unset or emptied, every request
# is refused with a 503 that names this variable.
# MKT_GOV_IAP_AUDIENCE=/projects/<number>/global/backendServices/<id>

# A verified sign-in domain -> the tenant id its consent records were loaded under.
# MKT_GOV_IAP_TENANT_DOMAINS_JSON={"bank.example": "reference-bank"}

# An EXACT service-account address -> tenant, for a programmatic caller. Never a domain: every
# account in a project shares one.
# MKT_GOV_IAP_MACHINE_TENANTS_JSON={"caller@your-gcp-project.iam.gserviceaccount.com": "reference-bank"}
